export type CaseStudySection = {
  id: string;
  kicker: string;
  heading: string;
  body: string[];
  image?: { src: string; alt: string; caption?: string; layout?: "full" | "split" | "stack" };
};

export type CaseStudyResult = {
  value: string;
  label: string;
  sublabel?: string;
};

export type CaseStudy = {
  status: "Live" | "In Progress" | "Archived";
  slug: string;
  title: string;
  tagline: string;
  overview: string[];
  isRedesign: boolean;
  meta: {
    industry: string;
    skills: string[];
    role: string[];
    date: string;
    duration: string;
    tools: string[];
  };
  liveUrl: string;
  heroImage: string;
  heroImageAlt: string;
  gallery: { src: string; alt: string; caption?: string }[];
  sections: CaseStudySection[];
  results: CaseStudyResult[];
  resultsFootnote?: string;
  stack: string[];
  designer?: { name: string; url: string };
  nextSlug: string | null;
};

