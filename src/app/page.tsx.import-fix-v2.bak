function lookupTZ(tz) { return TZ_MAP[tz] || null; }

const LANG_TZ = {
  "GB": "Europe/London", "NG": "Africa/Lagos", "CM": "Africa/Douala",
  "GH": "Africa/Accra", "KE": "Africa/Nairobi", "ZA": "Africa/Johannesburg",
