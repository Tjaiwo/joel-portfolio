"use client";

import { motion } from "framer-motion";
import { ArrowUpRight, ArrowLeft } from "lucide-react";
import type { CaseStudy } from "@/data/case-studies";

export function CaseStudyHero({ cs }: { cs: CaseStudy }) {
  return (
    <header className="relative overflow-hidden border-b border-border/40">
      {/* Subtle gradient backdrop, no big hero image overlay (cleaner) */}
      <div className="absolute inset-0 -z-10 bg-gradient-to-b from-muted/40 via-background to-background" />

      <div className="mx-auto max-w-6xl px-6 py-16 sm:py-20 lg:px-12 lg:py-24">
        {/* Back link */}
        <motion.div
          initial={{ opacity: 0, y: -8 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.4 }}
        >
          <a
            href="/#projects-skills"
            className="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            <ArrowLeft className="h-4 w-4" />
            Back to work
          </a>
        </motion.div>

        {/* Title + tagline (left-aligned, no overlay image competing) */}
        <motion.div
          initial={{ opacity: 0, y: 16 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.1 }}
          className="mt-10 max-w-3xl"
        >
          <h1 className="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
            {cs.title}
          </h1>
          <p className="mt-5 text-lg text-muted-foreground sm:text-xl lg:text-2xl">
            {cs.tagline}
          </p>
        </motion.div>

        {/* Live link */}
        <motion.div
          initial={{ opacity: 0, y: 16 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.25 }}
          className="mt-8"
        >
          <a
            href={cs.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            className="inline-flex items-center gap-2 rounded-md bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition-all hover:bg-primary/90 hover:translate-y-[-1px]"
          >
            View Live Site
            <ArrowUpRight className="h-4 w-4" />
          </a>
        </motion.div>

        {/* Metadata as bordered card grid (cleaner separation) */}
        <motion.div
          initial={{ opacity: 0, y: 16 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.4 }}
          className="mt-14 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-border/60 bg-border/60 sm:grid-cols-3 lg:grid-cols-5"
        >
          <MetaCell label="Industry" value={cs.meta.industry} />
          <MetaCell label="Role" value={cs.meta.role.join(", ")} className="col-span-2 sm:col-span-2" />
          <MetaCell label="Date" value={cs.meta.date} />
          <MetaCell label="Duration" value={cs.meta.duration} />
          <MetaCell label="Tools" value={cs.meta.tools.join(", ")} className="col-span-2 sm:col-span-3 lg:col-span-5" />
        </motion.div>

        {/* Hero image, full-width below metadata */}
        <motion.figure
          initial={{ opacity: 0, y: 24 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.7, delay: 0.5 }}
          className="mt-12 overflow-hidden rounded-lg border border-border/40 bg-muted/30"
        >
          {/* eslint-disable-next-line @next/next/no-img-element */}
          <img
            src={cs.heroImage}
            alt={cs.heroImageAlt}
            className="w-full h-auto object-cover"
            loading="eager"
          />
        </motion.figure>
      </div>
    </header>
  );
}

function MetaCell({ label, value, className = "" }: { label: string; value: string; className?: string }) {
  return (
    <div className={"bg-background p-5 " + className}>
      <dt className="text-[11px] font-semibold uppercase tracking-[0.14em] text-muted-foreground">
        {label}
      </dt>
      <dd className="mt-1.5 text-sm font-medium leading-snug">{value}</dd>
    </div>
  );
}
